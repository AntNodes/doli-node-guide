# Скопировать в .env (chmod 600). .env в git не попадает.

# Версия и коммит тега: git ls-remote https://github.com/doli-network/doli refs/tags/<тег>
DOLI_VERSION=v6.46.1
DOLI_COMMIT=7a8c3eb828a7f81da53a87e8aa247ec046607abf

# Папки на хосте, владелец uid 1000. NODE_DIR — данные (можно пересинхронизировать),
# KEYS_DIR — producer.json (chmod 700 на папку, 600 на файл).
NODE_DIR=/srv/doli/node
KEYS_DIR=/srv/doli/keys

# Лимит CPU контейнера. Не больше числа ядер сервера (nproc), иначе контейнер не стартует.
DOLI_CPUS=4

# Пусто — обычная нода. После регистрации producer'а:
# PRODUCER_ARGS=--producer --producer-key /keys/producer.json
PRODUCER_ARGS=
